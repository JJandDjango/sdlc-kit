{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdlc-kit:task-contract:v1",
  "version": "1.5.0",
  "title": "Task contract (G0 definition-of-ready)",
  "description": "Phase-0 task contract. Field set: ADR 0005, amended by ADR 0017 V2 (entities), ADR 0024 (required unit id, optional depends_on), ADR 0025 (optional unit confirmed_by), and ADR 0030 (entities required at ready, the empty list valid: a positive statement that the contract operates on no glossary term - TC017 on a miss). Root schema = draft profile (blocked dependencies representable, entities optional); validate #/$defs/ready for the G0.1 gate. The entities coverage join (ratified-only resolution) is a Python-side ready check - not expressible here. Unit-graph validity (duplicate id, depends_on resolution, acyclicity) is the same category - TC013-TC015, checked Python-side in both profiles. Unit confirmation (every unit's confirmed_by present and resolving to a value of the ratified intake-seat term) is a Python-side ready check - TC016; values are value-set members, not term slugs, so one character suffices. ADR 0030 makes that term required rather than the switch that arms the check: a repo with no term, or one still at draft, gets TC018 once per contract, also Python-side because no schema can see a repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "intent",
    "scope",
    "non_goals",
    "decomposition",
    "dependencies",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*(?![\\s\\S])"
    },
    "intent": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1200
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decomposition": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "entities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{2,63}$"
      }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit",
        "done_means",
        "acceptance_sketch"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "done_means": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_sketch": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          }
        },
        "confirmed_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "status"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "resolved",
            "blocked"
          ]
        },
        "blocked_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "blocked_by"
        ]
      },
      "else": {
        "not": {
          "required": [
            "blocked_by"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "enum": [
            "human-request",
            "g8-escape",
            "g9-maintenance"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "origin": {
            "const": "g8-escape"
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "required": [
          "ref"
        ]
      }
    },
    "ready_delta": {
      "required": [
        "entities"
      ],
      "properties": {
        "dependencies": {
          "items": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            }
          }
        }
      }
    },
    "ready": {
      "allOf": [
        {
          "$ref": "#"
        },
        {
          "$ref": "#/$defs/ready_delta"
        }
      ]
    }
  }
}
