{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"__import__('os').path.exists('.sdlc/hooks/protect_specs.py') and __import__('runpy').run_path('.sdlc/hooks/protect_specs.py', run_name='__main__')\""
          }
        ]
      }
    ]
  }
}
