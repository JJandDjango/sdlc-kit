{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdlc-kit:glossary-term:v1",
  "version": "1.0.0",
  "title": "Glossary term (vocabulary layer)",
  "description": "One ratifiable term - specs/vocabulary/<term-slug>.yaml, filename = stable ID (ADR 0017 V1). The door validates shape here; the filename/term equality and relation-ref resolution are directory checks in the vocab-check CLI - not expressible in a per-file schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "term",
    "name",
    "definition",
    "kind",
    "status",
    "since"
  ],
  "properties": {
    "term": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "kind": {
      "enum": [
        "entity",
        "relation",
        "attribute",
        "value-set"
      ]
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "is_a": {
          "$ref": "#/$defs/refs"
        },
        "part_of": {
          "$ref": "#/$defs/refs"
        },
        "disjoint_with": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "draft",
        "ratified",
        "deprecated"
      ]
    },
    "since": {
      "$ref": "#/$defs/date"
    },
    "sunset": {
      "$ref": "#/$defs/date"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "value-set"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "values"
        ]
      },
      "else": {
        "not": {
          "required": [
            "values"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "deprecated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "sunset"
        ]
      },
      "else": {
        "not": {
          "required": [
            "sunset"
          ]
        }
      }
    }
  ],
  "$defs": {
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{2,63}$"
      }
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
